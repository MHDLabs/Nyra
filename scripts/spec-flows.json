{
  "src": "src/flows.js",
  "outDir": "src/flows",
  "public": [
    "startAddConnectionFlow",
    "startEditConnectionFlow",
    "flowPromptLabel",
    "flowPromptDescription",
    "flowPromptBaseUrl",
    "flowPromptApiKey",
    "flowPromptModel",
