# Copy this file to `.dev.vars` for local development with `wrangler dev`.
# NEVER commit `.dev.vars` — it is gitignored for a reason.
#
# All three secrets are required and must be set manually. Nothing is derived
# from the bot token, and the Worker refuses every request (HTTP 500) if any of
# them is missing or malformed — see validateSecrets() in src/crypto.js.
# ADMIN_IDS is not a secret: it comes from [vars] in wrangler.toml.

# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Webhook secret token; also the X-Setup-Secret header for /setup.
# Generate: openssl rand -hex 32
TELEGRAM_SECRET=

# Base64-encoded 32-byte master key that encrypts every stored API key.
# Generate: openssl rand -base64 32
# Keep it stable — changing it makes existing stored keys undecryptable.
ENCRYPTION_KEY=

# Optional: cached bot identity (fetched automatically if omitted)
# TELEGRAM_BOT_ID=
# TELEGRAM_BOT_USERNAME=

# Optional: enables the agent's web_search tool. Without it the tool is hidden
# from the model, so it is never offered a tool it cannot execute.
# TAVILY_API_KEY=

# Optional: transcribes Telegram voice messages via Groq
# (whisper-large-v3-turbo). Without it, voice messages get a short
# "transcription not configured" notice. GROQ_STT_API_KEY is accepted as an
# alias for a dedicated speech key.
# GROQ_API_KEY=
# GROQ_STT_API_KEY=
