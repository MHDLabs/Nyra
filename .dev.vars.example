# Copy this file to `.dev.vars` for local development with `wrangler dev`.
# NEVER commit `.dev.vars` — it is gitignored for a reason.
#
# Only the bot token is required. The webhook secret and the encryption key
# are derived from it automatically at runtime (see src/crypto.js), so the two
# overrides below stay commented unless you want to pin your own values.
# (Deployments that already have them set keep using them unchanged.)
# ADMIN_IDS is not a secret: it comes from [vars] in wrangler.toml.

# Bot token from @BotFather — the only secret you must provide.
TELEGRAM_BOT_TOKEN=

# Optional overrides (auto-derived from TELEGRAM_BOT_TOKEN when omitted):
# TELEGRAM_SECRET=
# ENCRYPTION_KEY=

# Optional: cached bot identity (fetched automatically if omitted)
# TELEGRAM_BOT_ID=
# TELEGRAM_BOT_USERNAME=
