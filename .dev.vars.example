# Copy this file to `.dev.vars` for local development with `wrangler dev`.
# NEVER commit `.dev.vars` — it is gitignored for a reason.

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Random secret used to authenticate Telegram webhook calls.
# Generate one with: openssl rand -hex 32
TELEGRAM_SECRET=

# Base64-encoded 32-byte key used to encrypt stored AI API keys (AES-256-GCM).
# Generate one with: openssl rand -base64 32
ENCRYPTION_KEY=

# Comma-separated Telegram user IDs with admin access
ADMIN_IDS=

# Optional: cached bot identity (fetched automatically if omitted)
# TELEGRAM_BOT_ID=
# TELEGRAM_BOT_USERNAME=
