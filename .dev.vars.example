# Copy this file to `.dev.vars` for local development with `wrangler dev`.
# NEVER commit `.dev.vars` or put real credentials in Git.
#
# Required server-side secrets:
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET=
AI_API_KEY=

# Required model configuration. All users share this single model.
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

# Keep false unless the configured model and endpoint support image input.
AI_SUPPORTS_VISION=false

# Optional password for the standalone web admin panel.
ADMIN_PANEL_PASSWORD=

# Optional: enables live web search when configured.
# TAVILY_API_KEY=
